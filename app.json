{
  "expo": {
    "name": "Muscle Pal",
    "slug": "fitness-app",
    "version": "1.1.0",
    "scheme": "fitness",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shadev.musclepal",
      "appleTeamId": "2UNNRK9L5Q",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "ms-outlook"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.shadev.musclepal"
        ]
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.shadev.musclepal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#0B0B0C"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "com.android.vending.BILLING"
      ],
      "version": "1.1.1",
      "versionCode": 4,
      "icon": "./assets/brand/icon-android.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-video",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-light.png",
          "backgroundColor": "#F2F2F7",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/brand/splash.png",
            "backgroundColor": "#0B0B0C"
          },
          "android": {
            "image": "./assets/brand/splash-android-light.png",
            "backgroundColor": "#F2F2F7",
            "imageWidth": 288,
            "dark": {
              "image": "./assets/brand/splash-android.png",
              "backgroundColor": "#0B0B0C"
            }
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#C8FA3C",
