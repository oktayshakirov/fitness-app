{
  "expo": {
    "name": "Muscle Pal",
    "slug": "fitness-app",
    "version": "0.1.0",
    "scheme": "fitness",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shadev.musclepal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "ms-outlook"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.shadev.musclepal"
        ]
      }
    },
    "android": {
      "package": "com.shadev.musclepal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#0B0B0C"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-video",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#C8FA3C",
          "enableRemoteNotifications": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow this to see ads that are more relevant to you. Your workout data is never used for ads."
        }
      ],
      "expo-mail-composer",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "2UNNRK9L5Q"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "targetCellHeight": 2,
              "previewImage": "./assets/brand/icon.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "minHeight": "110dp",
              "name": "MusclePalRecovery",
              "label": "Muscle recovery",
              "minWidth": "110dp",
              "targetCellWidth": 2,
              "description": "How recovered you are and which muscles are resting."
            },
            {
              "targetCellHeight": 2,
              "previewImage": "./assets/brand/icon.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "minHeight": "110dp",
              "name": "MusclePalRecoveryWide",
              "label": "Muscle recovery (wide)",
              "minWidth": "250dp",
              "targetCellWidth": 4,
              "description": "How recovered you are and which muscles are resting."
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#0B0B0C",
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "name": "Muscle Pal",
      "backgroundColor": "#0B0B0C"
    }
  }
}
